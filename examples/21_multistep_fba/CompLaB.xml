<?xml version="1.0" ?>
<!-- =========================================================================
     CompLB3D EXAMPLE 21  |  MULTI-STEP (LEXICOGRAPHIC) FLUX BALANCE ANALYSIS
     =========================================================================

     Example 09 solves ONE linear program per voxel and takes what the
     simplex returns.  For the growth rate that is fine: the optimum is
     unique.  For the BY-PRODUCTS it is not.

     Run the E. coli core model in this medium and flux variability
     analysis says, at exactly the optimal growth of 0.5591 per hour:

         acetate export    anywhere from  9.9057  to  11.5033
         formate export    anywhere from  5.1129  to  11.5033

     Every one of those is optimal.  The solver returns whichever its
     pivoting rule reaches first.  Nothing is WRONG with that answer,
     but it is arbitrary, it need not survive a change of solver, and it
     cannot be compared against a measured yield.

     <multi_step> replaces the single program with a chain:

         1.  max  biomass                                 -> mu*
         2.  max  acetate export,  biomass >= a1 * mu*
         3.  max  formate export,  biomass >= a1 * mu*
                                   acetate >= a2 * (step 2)

     After step 3 nothing is free, and the same model at the same bounds
     returns the same numbers on any solver.

     WHAT THE RETAIN FRACTIONS DO.  At 1.0 the chain is strict: no stage
     may give up any of an earlier one.  Below 1.0 the organism may
     trade growth for excretion, which is what real cells do and what a
     genome-scale model will not do on its own:

         a = 1.0    growth 0.5591    acetate 11.5033   formate  5.1129
         a = 0.9    growth 0.5031    acetate 12.3529   formate 10.0423
         a = 0.6    growth 0.3354    acetate 14.9020   formate 16.5210

     Those fractions are CALIBRATION, not mechanism.  Song et al. (2025)
     fitted theirs to measured yields and reported them; anything below
     1.0 here should be reported the same way.  This case ships at 1.0,
     so the run carries no fitted parameter at all.

     Method: Song, H.-S. et al., Scientific Reports 15, 6042 (2025),
     "Formulation of multi-step FBA".  The same device is the
     lexicographic optimisation of DFBAlab, Gomez, Hoeffner & Barton,
     BMC Bioinformatics 15, 409 (2014).

     REACTIONS ARE NAMED, NOT NUMBERED.  <multi_step> needs an SBML
     model, because a column index stops meaning anything the moment the
     model file is regenerated.  A mistyped name stops the run at
     start-up with a suggestion; a mistyped index is never caught.
     ========================================================================= -->
<parameters>

    <path>
        <src_path>src</src_path>
        <input_path>input</input_path>
        <output_path>output</output_path>
    </path>

    <simulation_mode>
        <biotic_mode>true</biotic_mode>
        <enable_kinetics>false</enable_kinetics>
        <enable_abiotic_kinetics>false</enable_abiotic_kinetics>
        <enable_fba_glpk>true</enable_fba_glpk>
        <enable_fba_cobrapy>false</enable_fba_cobrapy>
        <enable_surrogate>false</enable_surrogate>
        <fba_concentration_basis>free</fba_concentration_basis>
        <glpk_lpsolver>1</glpk_lpsolver>
        <enable_validation_diagnostics>true</enable_validation_diagnostics>
    </simulation_mode>

    <LB_numerics>
        <domain>
            <nx>24</nx>
            <ny>26</ny>
            <nz>8</nz>
            <dx>10</dx>
            <unit>um</unit>
            <characteristic_length>24</characteristic_length>
            <filename>geometry.dat</filename>
            <material_numbers>
                <pore>2</pore>
                <solid>0</solid>
                <bounce_back>1</bounce_back>
                <microbe0>3</microbe0>
            </material_numbers>
        </domain>

        <delta_P>1e-6</delta_P>
        <Peclet>0</Peclet>
        <tau>0.8</tau>
        <track_performance>true</track_performance>

        <iteration>
            <ns_max_iT1>20000</ns_max_iT1>
            <ns_max_iT2>2000</ns_max_iT2>
            <ns_converge_iT1>1e-6</ns_converge_iT1>
            <ns_converge_iT2>1e-4</ns_converge_iT2>
            <ns_update_interval>10</ns_update_interval>
            <ade_update_interval>1</ade_update_interval>
            <ade_max_iT>500</ade_max_iT>
            <ade_converge_iT>1e-8</ade_converge_iT>
        </iteration>
    </LB_numerics>

    <chemistry>
        <number_of_substrates>4</number_of_substrates>
        <fix_concentration>no no no no</fix_concentration>
        <fix_lower_bounds>no no no no</fix_lower_bounds>

        <substrate0>                                    <!-- donor, held up from the left -->
            <name_of_substrates>glc</name_of_substrates>
            <initial_concentration>1.0</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>1.0</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate0>

        <substrate1>                                    <!-- acceptor, held up from the left -->
            <name_of_substrates>o2</name_of_substrates>
            <initial_concentration>1.0</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>1.0</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate1>

        <substrate2>                                    <!-- product, excreted -->
            <name_of_substrates>ac</name_of_substrates>
            <initial_concentration>0.</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>closed</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate2>

        <substrate3>                                    <!-- product, excreted -->
            <name_of_substrates>for</name_of_substrates>
            <initial_concentration>0.</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>closed</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate3>

    </chemistry>

    <microbiology>
        <number_of_microbes>1</number_of_microbes>
        <maximum_biomass_density>50</maximum_biomass_density>
        <thrd_biofilm_fraction>0.01</thrd_biofilm_fraction>
        <CA_method>fraction</CA_method>

        <microbe0>
            <name_of_microbes>Ecoli</name_of_microbes>
            <solver_type>FD</solver_type>
            <reaction_type>glpk</reaction_type>
            <initial_densities>1.0</initial_densities>
            <decay_coefficient>0.01</decay_coefficient>
            <viscosity_ratio_in_biofilm>0</viscosity_ratio_in_biofilm>
            <biomass_diffusion_coefficients>
                <in_pore>3e-13</in_pore>
                <in_biofilm>3e-13</in_biofilm>
            </biomass_diffusion_coefficients>
            <half_saturation_constants>0.05 0.02 0.05 0.05</half_saturation_constants>
            <model_filename>e_coli_core.xml</model_filename>

            <!-- which reaction exchanges each substrate, BY NAME, in substrate
                 order.  Names are resolved against the model at start-up, so a
                 typo is caught there with a suggestion.  The SBML "R_" prefix
                 is stripped by the reader, so it is not written here. -->
            <exchange_reaction_names>
                EX_glc__D_e  EX_o2_e  EX_ac_e  EX_for_e
            </exchange_reaction_names>

            <!-- ==============================================================
                 THE CHAIN.  Three stages, in order.  Stage 1 is growth; the
                 two after it pin the by-products that plain FBA leaves free.

                 <retain_fraction> is what each stage guarantees to the stages
                 after it.  All three are 1.0 here: strict lexicographic
                 optimisation, no fitted parameter.  Lower the first entry to
                 let the organism trade growth for excretion   and report the
                 value you used if you do.
                 ============================================================== -->
            <multi_step>
                <stage_reactions>
                    Biomass_Ecoli_core   EX_ac_e   EX_for_e
                </stage_reactions>
                <retain_fraction>  1.0  1.0  1.0  </retain_fraction>
                <stage_direction>  max  max  max  </stage_direction>
            </multi_step>

            <!-- Michaelis Menten Vmax, mmol/gDW/h, one per substrate.
                 Vs approaches 10 and 2 * Vo approaches 8, so the acceptor
                 limits and growth settles near 8. -->
            <fba_maximum_uptake_flux>10. 10. 0. 0.</fba_maximum_uptake_flux>

            <!-- hard floor and ceiling on the exchange fluxes.  Exchange
                 reactions are written "metabolite ->", so eating is negative. -->
            <substrate_lower_bounds>-10. -10.  0.  0.</substrate_lower_bounds>
            <substrate_upper_bounds>  0.   0. 50. 50.</substrate_upper_bounds>

            <objective_direction>maximize</objective_direction>

            <!-- grams dry weight per mole of cells: converts CompLB3D's molar
                 biomass into the gDW a metabolic model expects. -->
            <biomass_molar_mass>24.6</biomass_molar_mass>
            <left_boundary_type>closed</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>closed</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </microbe0>

    </microbiology>

    <equilibrium>
        <enabled>false</enabled>
    </equilibrium>

    <precipitation>
        <enabled>false</enabled>
    </precipitation>

    <dissolution>
        <enabled>false</enabled>
    </dissolution>

    <!-- The run's own scalar record: one row per interval with the total,
         mean, min and max of every field, plus the mass held where
         computeDensity cannot see it. Without this the case runs but
         nothing about it can be checked afterwards. -->
    <diagnostics>
        <enabled>true</enabled>
        <summary_csv>summary.csv</summary_csv>
        <interval>50</interval>
        <tolerance>1e-6</tolerance>
    </diagnostics>

    <IO>
        <read_NS_file>false</read_NS_file>
        <read_ADE_file>false</read_ADE_file>
        <ns_filename>nsLattice</ns_filename>
        <mask_filename>maskLattice</mask_filename>
        <subs_filename>subsLattice</subs_filename>
        <bio_filename>bioLattice</bio_filename>
        <save_VTK_interval>100</save_VTK_interval>
        <save_CHK_interval>0</save_CHK_interval>
        <debug_updRxn>0</debug_updRxn>
    </IO>

</parameters>
