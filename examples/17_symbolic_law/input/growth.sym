# Example 17: aerobic growth on acetate, dual Monod, written out by hand from a stage-B3 Pareto set.
# Yield 0.4 mol biomass per mol acetate; two oxygen per acetate. See this case's README.md.
version 1
units   per_hour
vars    acetate o2 Bug

# The two half-saturation constants were 0.05 and 0.01 until v1.3.3. Both were
# one to two orders of magnitude larger than any measured aerobic heterotroph,
# and both sat ten times above anything this case ever reaches, so the law never
# left its straight-line part and the constants could not be identified from the
# training table at all. See training/make_training_data.py.
rate    growth  = 0.35 * acetate / (5.0e-4 + acetate) * o2 / (1.0e-4 + o2)
rate    acetate = -2.5 * growth * Bug
rate    o2      = -5.0 * growth * Bug

range   acetate 1e-6 5.0e-3
range   o2      1e-6 2.0e-3
