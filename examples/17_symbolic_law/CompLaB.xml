<?xml version="1.0" ?>
<!-- =========================================================================
     CompLB3D EXAMPLE 17  |  A SYMBOLIC RATE LAW, READ FROM A TEXT FILE
     =========================================================================

     The same colony as example 05, with one thing changed: the rate
     law is not compiled into the program. It is read from
     input/growth.sym at start-up, printed into the log, and walked
     as an expression tree per voxel.

     Compare with 05. There the law lives in defineKinetics.hh and
     changing it means a rebuild. Here it is four lines of algebra in
     a text file, and a different law is a different file.

         growth  = 0.35 * acetate/(0.05+acetate) * o2/(0.01+o2)
         acetate = -2.5 * growth * Bug
         o2      = -5.0 * growth * Bug

     THE SUBSTRATE NAMES ARE THE BINDING. Every name in the file's
     vars line must match a <name_of_substrates> or the microbe's
     <name_of_microbes> exactly. A mismatch stops the run at start-up
     naming the offending variable, rather than binding to the wrong
     lattice.

     The ranges in the file are enforced at every evaluation, and the
     closing report says how many were clamped.
     ========================================================================= -->
<parameters>

    <path>
        <src_path>src</src_path>
        <input_path>input</input_path>
        <output_path>output</output_path>
    </path>

    <simulation_mode>
        <biotic_mode>true</biotic_mode>
        <enable_kinetics>false</enable_kinetics>
        <enable_abiotic_kinetics>false</enable_abiotic_kinetics>
        <enable_fba_glpk>false</enable_fba_glpk>
        <enable_fba_cobrapy>false</enable_fba_cobrapy>
        <enable_surrogate>false</enable_surrogate>
        <enable_validation_diagnostics>true</enable_validation_diagnostics>
    </simulation_mode>

    <LB_numerics>
        <domain>
            <nx>24</nx>
            <ny>24</ny>
            <nz>6</nz>
            <dx>10</dx>
            <unit>um</unit>
            <characteristic_length>24</characteristic_length>
            <filename>geometry.dat</filename>
            <material_numbers>
                <pore>2</pore>
                <solid>0</solid>
                <bounce_back>1</bounce_back>
                <microbe0>3</microbe0>
            </material_numbers>
        </domain>

        <delta_P>1e-6</delta_P>
        <Peclet>0</Peclet>
        <tau>0.8</tau>
        <track_performance>false</track_performance>

        <iteration>
            <ns_max_iT1>20000</ns_max_iT1>
            <ns_max_iT2>2000</ns_max_iT2>
            <ns_converge_iT1>1e-6</ns_converge_iT1>
            <ns_converge_iT2>1e-4</ns_converge_iT2>
            <ns_update_interval>10</ns_update_interval>
            <ade_update_interval>1</ade_update_interval>
            <ade_max_iT>1000</ade_max_iT>
            <ade_converge_iT>1e-8</ade_converge_iT>
        </iteration>
    </LB_numerics>

    <!-- The rate law lives here, not in a header. -->
    <symbolic>
        <enabled>true</enabled>
        <expressions_file>input/growth.sym</expressions_file>
    </symbolic>

    <chemistry>
        <number_of_substrates>2</number_of_substrates>

        <substrate0>                                    <!-- fed from the left so the colony does not starve -->
            <name_of_substrates>acetate</name_of_substrates>   <!-- matches vars in growth.sym -->
            <initial_concentration>2.0e-3</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>4.0e-3</left_boundary_condition>   <!-- inside the fitted range -->
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate0>

        <substrate1>
            <name_of_substrates>o2</name_of_substrates>        <!-- matches vars in growth.sym -->
            <initial_concentration>1.0e-3</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>2e-9</in_pore>
                <in_biofilm>1e-9</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>1.5e-3</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate1>

    </chemistry>

    <microbiology>
        <number_of_microbes>1</number_of_microbes>
        <maximum_biomass_density>1.0e-3</maximum_biomass_density>
        <thrd_biofilm_fraction>0.01</thrd_biofilm_fraction>
        <CA_method>fraction</CA_method>

        <microbe0>                                <!-- seeded on material number 3 -->
            <name_of_microbes>Bug</name_of_microbes>        <!-- matches vars in growth.sym -->
            <solver_type>CA</solver_type>
            <reaction_type>symbolic</reaction_type>
            <initial_densities>1.0e-5</initial_densities>
            <decay_coefficient>0.0</decay_coefficient>
            <viscosity_ratio_in_biofilm>0</viscosity_ratio_in_biofilm>
            <half_saturation_constants>0 0</half_saturation_constants>   <!-- unused: the .sym carries its own -->
            <maximum_uptake_flux>0 0</maximum_uptake_flux>
            <left_boundary_type>Neumann</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </microbe0>

    </microbiology>

    <equilibrium>
        <enabled>false</enabled>
    </equilibrium>

    <precipitation>
        <enabled>false</enabled>
    </precipitation>

    <dissolution>
        <enabled>false</enabled>
    </dissolution>

    <IO>
        <read_NS_file>false</read_NS_file>
        <read_ADE_file>false</read_ADE_file>
        <ns_filename>nsLattice</ns_filename>
        <mask_filename>maskLattice</mask_filename>
        <subs_filename>subsLattice</subs_filename>
        <bio_filename>bioLattice</bio_filename>
        <save_VTK_interval>200</save_VTK_interval>
        <save_CHK_interval>0</save_CHK_interval>
        <debug_updRxn>0</debug_updRxn>
    </IO>

</parameters>
